# Prueba 2: numeros, operadores y expresiones
barista chorreador() {
    grano a = 10;
    poso b = 3.14;
    grano c = (a + 5) * 2 - 4 / 2 % 3;
    cafe r1 = a == 10;
    cafe r2 = a != 3;
    cafe r3 = a < 5;
    cafe r4 = a <= 5;
    cafe r5 = b > 1.5;
    cafe r6 = b >= 3.14;
    cafe r7 = Amargo r1 ConAzucar r2 SinAzucar r3;
    poso d = 0.001 + 100.0;
    grano e = 007;
}
